# ── App ───────────────────────────────────────────────
APP_NAME=CyberNeura Backend
APP_ENV=development
DEBUG=false

HOST=0.0.0.0
PORT=8000

# ── CORS ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Supabase ──────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Firebase Admin SDK ────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ── ML Model ──────────────────────────────────────────
MODEL_PATH=ml/models/url_model.joblib
MODEL_METADATA_PATH=ml/models/model_metadata.json

# ── Rate Limiting ─────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Demo / Dev Auth ───────────────────────────────────
# Set to true ONLY in development. Never true in production.
ALLOW_DEMO_AUTH=false

# ── Optional: External AI (LLM: Groq / OpenAI) ────────
# For Groq: set AI_PROVIDER=groq, GROQ_API_KEY=gsk_..., AI_MODEL=llama-3.3-70b-versatile
# For OpenAI: set AI_PROVIDER=openai, AI_API_KEY=sk-..., AI_MODEL=gpt-4o-mini
AI_PROVIDER=groq
AI_API_KEY=
GROQ_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# ── Optional: GeoIP ───────────────────────────────────
GEOIP_API_URL=
GEOIP_API_KEY=

# ── Risk Thresholds ───────────────────────────────────
RISK_THRESHOLD_SAFE=30
RISK_THRESHOLD_SUSPICIOUS=70

# ── Phase 2: Threat Intelligence Providers ─────────────
# Google Web Risk Lookup API key
GOOGLE_WEB_RISK_API_KEY=

# PhishTank Application Key (optional, improves rate limits)
PHISHTANK_APP_KEY=

# URLhaus Auth Key (abuse.ch API key)
URLHAUS_AUTH_KEY=

# Threat intelligence configuration
THREAT_INTEL_TIMEOUT_SECONDS=5
THREAT_INTEL_CACHE_TTL_SECONDS=900
THREAT_INTEL_MAX_CONCURRENT_REQUESTS=3

# Provider toggles
ENABLE_GOOGLE_WEB_RISK=true
ENABLE_PHISHTANK=true
ENABLE_URLHAUS=true

# Development mock mode (deterministic offline provider responses for local testing)
THREAT_INTEL_MOCK_MODE=false

